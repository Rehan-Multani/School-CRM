# Gateway base URL. On a real phone "localhost" is the phone itself —
# use your PC's LAN IP (ipconfig → IPv4) and keep phone + PC on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.29:5000/api/v1

# Dev-only login prefill (ignored in release builds). Fill real accounts in .env.local.
EXPO_PUBLIC_DEV_TEACHER_ID=
EXPO_PUBLIC_DEV_TEACHER_PASSWORD=
EXPO_PUBLIC_DEV_STUDENT_ID=
EXPO_PUBLIC_DEV_STUDENT_PASSWORD=
EXPO_PUBLIC_DEV_PARENT_ID=
EXPO_PUBLIC_DEV_PARENT_PASSWORD=
EXPO_PUBLIC_DEV_DRIVER_ID=
EXPO_PUBLIC_DEV_DRIVER_PASSWORD=
