              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409\", () => pm.response.code === 409);",
                  "pm.test(\"code PICKUP_ALREADY_ACTIVE\", () => pm.response.json().code === 'PICKUP_ALREADY_ACTIVE');"
