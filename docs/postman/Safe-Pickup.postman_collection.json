    {
      "name": "Teacher / Student Pickup",
      "item": [
        {
          "name": "GET eligible students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/school-portal/teacher/pickups/eligible-students?sectionId={{sectionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "school-portal",
                "teacher",
                "pickups",
                "eligible-students?sectionId={{sectionId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.code === 200);",
                  "pm.test(\"success\", () => pm.response.json().success === true);",
                  "const d = pm.response.json().data;",
                  "pm.test(\"array\", () => Array.isArray(d));",
                  "const s = (d || []).find(x => x.pickupEnabled && x.hasGuardianMobile && !x.alreadyPickedUpToday);",
                  "if (s) pm.environment.set('pickupStudentId', s.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST initiate (Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/school-portal/teacher/pickups/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "school-portal",
                "teacher",
                "pickups",
                "initiate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{pickupStudentId}}\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.code === 201);",
                  "const d = pm.response.json().data;",
                  "pm.test(\"OTP_SENT\", () => d.status === 'OTP_SENT');",
                  "pm.test(\"masked mobile\", () => /^\\*+\\d{4}$/.test(d.maskedMobile));",
                  "pm.test(\"no raw otp/hash\", () => !('otpHash' in d) && !('guardianMobile' in d));",
                  "pm.environment.set('pickupSessionId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST initiate again (no key) -> 409 ALREADY_ACTIVE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/school-portal/teacher/pickups/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "school-portal",
                "teacher",
                "pickups",
                "initiate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{pickupStudentId}}\"\n}"
            },
            "auth": {
              "type": "bearer",
