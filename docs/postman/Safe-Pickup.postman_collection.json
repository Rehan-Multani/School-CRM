{
  "info": {
    "name": "School Management - Student Safe Pickup",
    "_postman_id": "safe-pickup-0001-4a11-9d33-teacherapk0002",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Student Safe Pickup / Parent OTP verification. baseUrl -> platform-service :5002 (no /api/v1/platform prefix). Set the three tokens in the environment: superAdminToken (SuperAdmin JWT), schoolAdminToken (from School-Admin login), accessToken (from teacher-login). RUN ORDER: Super Admin / Enable -> School Admin / Get + Enable school + Enable class -> Teacher / Eligible -> Initiate -> Verify (otp 123456) -> Complete. Staging OTP is always 123456."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.environment.set(\"pickupOtp\", pm.environment.get(\"pickupOtp\") || \"123456\");"
        ]
      }
    }
  ],
  "item": [
