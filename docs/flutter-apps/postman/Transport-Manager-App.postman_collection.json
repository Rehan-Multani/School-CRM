{
 "info": {
  "name": "Transport Manager App (Flutter) — localhost",
  "description": "Transport Manager app API. Full localhost URLs (API gateway :5000), no baseUrl variable.\nThe manager is a staff account (role Transport Manager, created in School Admin -> Users) that signs in with EMAIL + password. They read every route, its students and the fleet, and write one thing: a student's daily Picked Up / Dropped (plus undoing a wrong tap).\nDemo login (npm run seed:app-demo): transport.demo@example.com / Demo@12345 - 2 routes, 16 riders, today half picked up.\nRules enforced by the backend: own school only; today or an earlier date; drop needs a pickup first; a pickup cannot be undone while the drop stands; the route must have a vehicle and a driver. Marking twice is safe (idempotent). No GPS, trips, SOS or notifications.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{token}}",
    "type": "string"
   }
  ]
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "// Keeps {{today}} current so date-based requests always work.",
     "const d = new Date();",
     "const pad = (n) => String(n).padStart(2, '0');",
     "pm.collectionVariables.set('today', `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`);"
    ]
   }
  }
 ],
 "variable": [
  {
   "key": "token",
   "value": "",
   "description": "Auto-filled by the Login request."
  },
  {
   "key": "today",
   "value": "",
   "description": "Auto-filled (YYYY-MM-DD) before every request."
  },
  {
   "key": "schoolPrimaryColor",
   "value": "",
   "description": "Auto-filled from login -> school.primaryColor."
  },
  {
   "key": "routeId",
   "value": "",
   "description": "From Overview (first route)."
  },
  {
   "key": "studentId",
   "value": "",
   "description": "From Route run (first rider still pending)."
  },
  {
   "key": "resetToken",
   "value": "",
   "description": "From Forgot password 2."
  }
 ],
 "item": [
  {
   "name": "01 Auth",
   "description": "Email (or employee ID) + password. The account is a staff user with the Transport Manager role, created in School Admin -> Users.",
   "item": [
    {
     "name": "Login (email + password)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "http://localhost:5000/api/v1/platform/school-portal/auth/transport-login",
       "protocol": "http",
       "host": [
        "localhost"
       ],
       "port": "5000",
       "path": [
        "api",
        "v1",
        "platform",
        "school-portal",
        "auth",
        "transport-login"
       ]
      },
      "description": "Response: { success, message, token, manager, user, school }. `identifier` may also be the employee ID. 401 TRANSPORT_INVALID_CREDENTIALS for an unknown email and a wrong password alike; 403 TRANSPORT_MANAGER_INACTIVE; 409 when the login exists at more than one school; 429 after 20 attempts in 15 minutes.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"identifier\": \"transport.demo@example.com\",\n  \"password\": \"Demo@12345\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Login OK', () => pm.expect(pm.response.code).to.eql(200));",
         "const j = pm.response.json();",
         "// Same shape as teacher / student / parent: token at the top level.",
         "if (j.token) { pm.collectionVariables.set('token', j.token); console.log('token saved'); }",
         "if (j.school) { pm.collectionVariables.set('schoolPrimaryColor', j.school.primaryColor || ''); }"
        ]
       }
      }
     ]
    },
    {
     "name": "Me (session restore)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "http://localhost:5000/api/v1/platform/school-portal/transport-manager/me",
       "protocol": "http",
       "host": [
        "localhost"
       ],
       "port": "5000",
       "path": [
        "api",
        "v1",
        "platform",
        "school-portal",
        "transport-manager",
        "me"
       ]
      },
      "description": "Call on app start. 401 -> go to Login. Reachable even when the school subscription has expired."
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('HTTP 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
         "let j = {}; try { j = pm.response.json(); } catch (e) {}",
         "pm.test('success === true', () => pm.expect(j.success).to.eql(true));"
        ]
       }
      }
     ]
    },
    {
     "name": "Change password",
     "request": {
      "method": "PATCH",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
