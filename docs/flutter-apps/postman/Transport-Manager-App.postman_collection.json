        "localhost"
       ],
       "port": "5000",
       "path": [
        "api",
        "v1",
        "platform",
        "school-portal",
        "transport-manager",
        "change-password"
       ]
      },
      "description": "Min 8 characters. 401 CURRENT_PASSWORD_INVALID when the current password is wrong. Signs out every other device and returns a fresh token in data.token.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"currentPassword\": \"Demo@12345\",\n  \"newPassword\": \"Demo@12345\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('HTTP 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
         "let j = {}; try { j = pm.response.json(); } catch (e) {}",
         "pm.test('success === true', () => pm.expect(j.success).to.eql(true));",
         "// Every other session ends; this response carries the token to keep using.",
         "if (j.data && j.data.token) { pm.collectionVariables.set('token', j.data.token); }"
        ]
       }
      }
     ]
    },
