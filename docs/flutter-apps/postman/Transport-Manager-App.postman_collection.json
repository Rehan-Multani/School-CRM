  {
   "name": "04 Edge cases (expected errors)",
   "description": "Each request here is supposed to fail; the test checks the status and code the app must handle.",
   "item": [
    {
     "name": "Drop before pickup -> 409",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       },
       {
