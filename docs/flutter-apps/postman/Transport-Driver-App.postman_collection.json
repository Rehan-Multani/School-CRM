    },
    {
      "name": "03 My Students (daily list)",
      "description": "Ordered by stop sequence. Each row: studentId, name, admissionNumber, rollNumber, className, stop{id,stopName,sequenceOrder}, pickupTime, dropTime, pickupStatus (PENDING|PICKED_UP), pickedUpAt, dropStatus (PENDING|DROPPED), droppedAt.",
      "item": [
        {
          "name": "Today's students",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/platform/school-portal/driver/students",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "platform",
                "school-portal",
                "driver",
                "students"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "pm.test('success === true', () => pm.expect(j.success).to.eql(true));",
                  "function pickFirst(j, keys) {\n  const d = j && j.data !== undefined ? j.data : j;\n  let arr = Array.isArray(d) ? d : null;\n  if (!arr && d && typeof d === 'object') {\n    for (const k of ['items', 'data', 'students', 'children', 'rows', 'list', 'sections', 'entries', 'notifications']) {\n      if (Array.isArray(d[k])) { arr = d[k]; break; }\n    }\n    if (!arr) arr = Object.values(d).find(Array.isArray) || null;\n  }\n  const x = arr ? arr[0] : null;\n  if (!x) return null;\n  for (const k of keys) if (x[k]) return typeof x[k] === 'object' ? (x[k].id || x[k]._id) : x[k];\n  return null;\n}\nfunction pickObj(j, keys) {\n  const d = j && j.data !== undefined ? j.data : j;\n  if (!d || typeof d !== 'object') return null;\n  for (const k of keys) if (d[k]) return d[k];\n  return null;\n}",
                  "{ const v = pickFirst(j, [\"studentId\"]); if (v) { pm.collectionVariables.set('studentId', String(v)); console.log('studentId =', v); } }"
                ]
              }
            }
          ]
        },
        {
          "name": "Students for a date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/platform/school-portal/driver/students?date={{today}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "platform",
                "school-portal",
                "driver",
                "students"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{today}}",
                  "description": "YYYY-MM-DD",
                  "disabled": false
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "pm.test('success === true', () => pm.expect(j.success).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
