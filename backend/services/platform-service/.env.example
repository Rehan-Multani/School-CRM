# ---------------------------------------------------------------------------
# Platform Service — every role portal except Super Admin identity.
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5002

MONGO_URI=mongodb://127.0.0.1:27017/school_crm_platform

# REQUIRED IN PRODUCTION — at least 32 characters. This signs the tokens for
# every school role (admin, principal, teacher, student, parent, accountant, HR,
# librarian, transport), so a weak value lets anyone forge any role for any
# school. The service refuses to boot in production without it; in development it
# falls back to an ephemeral per-process value and logs a warning.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# ----- Email (password reset, notifications). Leave blank to disable. -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ----- Razorpay -----
# Key id/secret enable online payments (subscriptions + parent fee "Pay Now").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for recurring subscriptions: this verifies webhook signatures, which
# is what makes a payment authoritative. Blank disables webhook processing
# outright rather than trusting an unverified event.
RAZORPAY_WEBHOOK_SECRET=

# ----- Push notifications (FCM). Base64 of the service-account JSON. -----
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ----- Student Safe Pickup OTP -----
# 'random' issues a cryptographically secure code; 'static' always returns
# SAFE_PICKUP_STATIC_OTP and exists only so QA can run the flow without SMS.
# Production forces 'random' and refuses to boot if 'static' is set explicitly.
SAFE_PICKUP_OTP_MODE=random
SAFE_PICKUP_STATIC_OTP=123456
SAFE_PICKUP_OTP_LENGTH=6
SAFE_PICKUP_OTP_EXPIRY_SECONDS=300
SAFE_PICKUP_MAX_ATTEMPTS=5
SAFE_PICKUP_RESEND_COOLDOWN_SECONDS=30
SAFE_PICKUP_MAX_RESENDS=3

# SMS delivery for the pickup OTP. 'mock' logs instead of sending — a real
# provider must be configured before Safe Pickup goes live.
SMS_PROVIDER=mock
