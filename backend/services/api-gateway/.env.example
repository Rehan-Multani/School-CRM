# ---------------------------------------------------------------------------
# API Gateway — copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Comma-separated allowlist of browser origins. There is no wildcard: an origin
# that is not listed gets no CORS header and the browser blocks the response.
# Add every frontend you serve (school portals app + the super-admin app).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Downstream services the gateway proxies to.
AUTH_SERVICE_URL=http://127.0.0.1:5001
PLATFORM_SERVICE_URL=http://127.0.0.1:5002
