# ---------------------------------------------------------------------------
# Auth Service (Super Admin identity) — copy to `.env` and fill in.
# Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001

MONGO_URI=mongodb://127.0.0.1:27017/school_crm_platform

# REQUIRED IN PRODUCTION — each must be at least 32 characters, and the two must
# differ (a shared secret lets an access token be replayed as a refresh token).
# The service refuses to boot in production without them; in development it
# falls back to an ephemeral per-process value and logs a warning.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# Access tokens are deliberately short-lived; the client silently refreshes on
# 401. Refresh tokens are single-use, rotated, and revocable server-side.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Seed account created by `npm run seed`. REQUIRED IN PRODUCTION — without it the
# seeder generates a random dev password and prints it to the server log.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-me-with-a-strong-password
SUPERADMIN_NAME=Super Admin
